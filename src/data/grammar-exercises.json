[
  {"sentence":"저______ 학생이에요.","vi":"Tôi là học sinh.","options":["는","은","를","을"],"answer":"는","note":"저 không có patchim → 는."},
  {"sentence":"선생님______ 한국 사람이에요.","vi":"Giáo viên là người Hàn Quốc.","options":["은","는","을","를"],"answer":"은","note":"선생님 có patchim ㅁ → 은."},
  {"sentence":"비______ 와요.","vi":"Trời mưa.","options":["가","이","을","를"],"answer":"가","note":"비 không có patchim → chủ ngữ dùng 가."},
  {"sentence":"동생______ 학교에 가요.","vi":"Em tôi đi học.","options":["이","가","을","를"],"answer":"이","note":"동생 có patchim ㅇ → chủ ngữ dùng 이."},
  {"sentence":"밥______ 먹어요.","vi":"Tôi ăn cơm.","options":["을","를","에","에서"],"answer":"을","note":"밥 có patchim ㅂ → tân ngữ dùng 을."},
  {"sentence":"커피______ 마셔요.","vi":"Tôi uống cà phê.","options":["를","을","에","에서"],"answer":"를","note":"커피 không có patchim → tân ngữ dùng 를."},
  {"sentence":"저는 의사______.","vi":"Tôi là bác sĩ.","options":["예요","이에요","아요","어요"],"answer":"예요","note":"의사 không có patchim → 예요."},
  {"sentence":"이것은 책______.","vi":"Đây là quyển sách.","options":["이에요","예요","아요","어요"],"answer":"이에요","note":"책 có patchim ㄱ → 이에요."},
  {"sentence":"저______ 학생이에요.","vi":"Tôi cũng là học sinh.","options":["도","를","에","에서"],"answer":"도","note":"도 = “cũng”, thay cho 은/는/이/가."},
  {"sentence":"학교______ 가요.","vi":"Tôi đi đến trường.","options":["에","이","과","하고"],"answer":"에","note":"에 đứng sau nơi đến của động từ đi/đến."},
  {"sentence":"세 시______ 만나요.","vi":"Gặp nhau lúc 3 giờ.","options":["에","에서","를","와"],"answer":"에","note":"에 cũng dùng sau mốc thời gian."},
  {"sentence":"도서관______ 공부해요.","vi":"Tôi học ở thư viện.","options":["에서","에","를","도"],"answer":"에서","note":"에서 chỉ nơi diễn ra hành động."},
  {"sentence":"친구______ 가요.","vi":"Tôi đi cùng bạn.","options":["랑","이랑","를","에서"],"answer":"랑","note":"친구 không có patchim → 랑 (có patchim thì dùng 이랑)."},
  {"sentence":"밥을 먹______.","vi":"Tôi ăn cơm.","options":["어요","아요","해요","세요"],"answer":"어요","note":"Gốc 먹 có nguyên âm ㅓ (không phải ㅏ/ㅗ) → 어요."},
  {"sentence":"날씨가 좋______.","vi":"Thời tiết đẹp.","options":["아요","어요","해요","세요"],"answer":"아요","note":"Gốc 좋 có nguyên âm ㅗ → 아요."},
  {"sentence":"도서관에서 공부______.","vi":"Tôi học ở thư viện.","options":["해요","하아요","하어요","하요"],"answer":"해요","note":"하다 luôn chia thành 해요."},
  {"sentence":"저는 학교에 갑______.","vi":"Tôi đi học. (trang trọng)","options":["니다","습니다","어요","아요"],"answer":"니다","note":"Gốc 가 không có patchim → thêm ㅂ vào thành 갑, rồi + 니다."},
  {"sentence":"밥을 먹______.","vi":"Tôi ăn cơm. (trang trọng)","options":["습니다","니다","어요","아요"],"answer":"습니다","note":"Gốc 먹 có patchim → 습니다."},
  {"sentence":"저는 김치를 ______ 먹어요.","vi":"Tôi không ăn kim chi.","options":["안","못","잘","도"],"answer":"안","note":"안 = không (phủ định). 못 = không thể, nghĩa khác."},
  {"sentence":"커피를 마시______ 싶어요.","vi":"Tôi muốn uống cà phê.","options":["고","는","러","면"],"answer":"고","note":"V + 고 싶다 = muốn làm gì."},
  {"sentence":"여기 앉______.","vi":"Xin mời ngồi đây.","options":["으세요","세요","으시요","이에요"],"answer":"으세요","note":"Gốc 앉 có patchim → 으세요."},
  {"sentence":"어제 영화를 ______.","vi":"Hôm qua tôi đã xem phim.","options":["봤어요","봐요","볼 거예요","보세요"],"answer":"봤어요","note":"Có “어제” (hôm qua) → quá khứ 았/었어요: 보 + 았어요 → 봤어요."},
  {"sentence":"내일 친구를 ______.","vi":"Ngày mai tôi sẽ gặp bạn.","options":["만날 거예요","만났어요","만나고","만나세요"],"answer":"만날 거예요","note":"Có “내일” (ngày mai) → tương lai (으)ㄹ 거예요. Gốc 만나 không có patchim → 만날 거예요."},
  {"sentence":"밥을 먹______ 공부해요.","vi":"Ăn cơm rồi học bài.","options":["고","지만","러","면"],"answer":"고","note":"V + 고 nối hai hành động: “và / rồi”."}
]
